{
  "uid": "lex-orion-task4",
  "title": "Lex Orion | Task 4 Monitoring and Logging",
  "tags": [
    "task4",
    "lex-orion"
  ],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Application availability",
      "type": "stat",
      "description": "1 = health endpoint is responding; 0 = unavailable.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lex-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lex_orion_app_available",
          "legendFormat": "Application availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Application uptime",
      "type": "stat",
      "description": "Time since the real Streamlit app process started.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lex-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "lex_orion_uptime_seconds",
          "legendFormat": "Application uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Mean HTTP latency",
      "type": "stat",
      "description": "Mean response time of actual Streamlit HTTP requests over one minute. Does not measure LLM calls.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lex-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * sum(rate(lex_orion_http_request_duration_seconds_sum[1m])) / clamp_min(sum(rate(lex_orion_http_request_duration_seconds_count[1m])), 0.000001)",
          "legendFormat": "Mean HTTP latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "HTTP error rate",
      "type": "stat",
      "description": "Percentage of HTTP requests returning 4xx or 5xx over one minute.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "lex-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(lex_orion_http_requests_total{status=~\"4..|5..\"}[1m])) / clamp_min(sum(rate(lex_orion_http_requests_total[1m])), 0.000001)",
          "legendFormat": "HTTP error rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
