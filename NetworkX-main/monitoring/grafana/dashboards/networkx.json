{
  "id": null,
  "uid": "networkx-devops",
  "title": "NetworkX · DevOps Monitoring",
  "tags": [
    "networkx",
    "devops"
  ],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "networkx-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "id": 1,
      "title": "Metrics availability",
      "type": "stat",
      "description": "UP means Prometheus successfully fetched authenticated metrics. It is not a full prediction health check.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"networkx\"}",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "networkx-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "id": 2,
      "title": "Requests since restart",
      "type": "stat",
      "description": "Exact request counter since app startup. Health, readiness and metrics scrapes are excluded.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(networkx_http_requests_total{job=\"networkx\"})",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "networkx-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "id": 3,
      "title": "Client errors (4xx)",
      "type": "stat",
      "description": "HTTP 4xx responses since app startup, including invalid CSVs (422).",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(networkx_http_requests_total{job=\"networkx\",status=~\"4..\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "networkx-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "id": 4,
      "title": "Server errors (5xx)",
      "type": "stat",
      "description": "HTTP 5xx responses since app startup. Details are in Render console logs.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(networkx_http_requests_total{job=\"networkx\",status=~\"5..\"}) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "networkx-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "reqpm"
        },
        "overrides": []
      },
      "id": 5,
      "title": "Prediction traffic by status (requests/min)",
      "type": "timeseries",
      "description": "Calculated request rate over the last minute. Wait for at least two scrapes before generating demo traffic.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(networkx_http_requests_total{job=\"networkx\",route=\"/predict\"}[1m])) * 60",
          "legendFormat": "HTTP {{status}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "networkx-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "id": 6,
      "title": "Average prediction response time",
      "type": "timeseries",
      "description": "Average app response duration over five minutes; no data when there is no prediction traffic.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(networkx_http_request_duration_seconds_sum{job=\"networkx\",route=\"/predict\"}[5m])) / sum(rate(networkx_http_request_duration_seconds_count{job=\"networkx\",route=\"/predict\"}[5m]))",
          "legendFormat": "Average response time",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ]
}
