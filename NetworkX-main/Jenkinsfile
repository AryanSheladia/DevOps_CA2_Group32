pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 20, unit: 'MINUTES')
    }

    triggers {
        // Requires the Jenkins job to use this repository as its SCM source.
        pollSCM('H/5 * * * *')
    }

    environment {
        APP_URL = 'https://networkx-devops-group32.onrender.com'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def checkoutInfo = checkout scm
                    env.GIT_COMMIT = checkoutInfo.GIT_COMMIT
                    env.APP_IMAGE = "networkx-assessment:${env.GIT_COMMIT}"
                    env.SMOKE_CONTAINER = "networkx-prediction-smoke-${env.BUILD_NUMBER}"
                }
            }
        }

        stage('Build') {
            steps {
                dir('NetworkX-main') {
                    sh 'docker build --pull -t "$APP_IMAGE" .'
                }
            }
        }

        stage('Prediction smoke test') {
            steps {
                sh '''
                    set -eu
                    docker rm -f "$SMOKE_CONTAINER" >/dev/null 2>&1 || true
                    docker run -d --name "$SMOKE_CONTAINER" \
                        --network "container:$(hostname)" \
                        -e APP_VERSION="$GIT_COMMIT" \
                        "$APP_IMAGE"
                    trap 'docker rm -f "$SMOKE_CONTAINER" >/dev/null 2>&1 || true' EXIT
                    python3 NetworkX-main/step3-jenkins/smoke_test.py \
                        --base-url http://127.0.0.1:8000 \
                        --csv NetworkX-main/valid_data/test.csv
                '''
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([string(credentialsId: 'render-deploy-hook', variable: 'RENDER_DEPLOY_HOOK')]) {
                    sh '''
                        set +x
                        curl --fail --silent --show-error \
                            --request POST "$RENDER_DEPLOY_HOOK" \
                            --output /dev/null
                        echo 'Render deploy hook accepted the request.'
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    set -eu
                    expected="$GIT_COMMIT"
                    attempt=0
                    while [ "$attempt" -lt 40 ]; do
                        actual=$(curl --fail --silent --show-error "$APP_URL/version" \
                            | python3 -c 'import json,sys; print(json.load(sys.stdin)["commit"])') || actual=''
                        if [ "$actual" = "$expected" ]; then
                            echo "Deployed commit verified: $actual"
                            exit 0
                        fi
                        attempt=$((attempt + 1))
                        sleep 15
                    done
                    echo "Render did not report tested commit $expected (last value: ${actual:-unavailable})." >&2
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            sh 'docker rm -f "$SMOKE_CONTAINER" >/dev/null 2>&1 || true'
        }
    }
}
